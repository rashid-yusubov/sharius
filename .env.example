# =============================================================
# Пример конфигурации окружения (.env.example)
# Скопируйте этот файл в .env перед первым запуском:
# cp .env.example .env
# =============================================================

# База данных PostgreSQL
DB_NAME=project_db
DB_USER=project_user
DB_PASSWORD=project_password
DB_PORT=5432

# Бэкенд (FastAPI)
BACKEND_PORT=9000
JWT_SECRET=dev-secret-key-change-in-production
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:9000,http://localhost:9000

# Фронтенд (React + Vite)
# BUILD_TARGET: 'development' (Vite dev server с горячей перезагрузкой) или 'production' (сборка dist + serve)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:9000
BUILD_TARGET=development
NODE_ENV=development
