# Production environment variables (for Portainer Stack)

# Database credentials
POSTGRES_DB=sharius
POSTGRES_USER=sharius_user
POSTGRES_PASSWORD=generate_a_strong_password_here

# Security
JWT_SECRET=generate_a_random_jwt_secret_here

# Network and ports
FRONTEND_PORT=3000

# App settings
SESSION_TTL_MINUTES=15
CORS_ORIGINS=*

