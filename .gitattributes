# Auto detect text files and enforce LF line endings
* text=auto eol=lf

# Shell scripts
*.sh text eol=lf

# Frontend
*.json text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Backend / Config
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
